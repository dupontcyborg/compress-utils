diff --git a/lib/common/mem.h b/lib/common/mem.h
index e66a2ea..07f3a41 100644
--- a/lib/common/mem.h
+++ b/lib/common/mem.h
@@ -137,6 +137,30 @@ MEM_STATIC size_t MEM_swapST(size_t in);
 MEM_STATIC unsigned MEM_32bits(void) { return sizeof(size_t)==4; }
 MEM_STATIC unsigned MEM_64bits(void) { return sizeof(size_t)==8; }
 
+/* Register width, as opposed to address width (MEM_32bits() / MEM_64bits()).
+ * wasm32 has 32-bit pointers but native 64-bit integer registers, so the bit
+ * containers, the Huffman/FSE reload decisions and the row-hash SWAR mask are
+ * better off on U64 there. Enabled with ZSTD_WASM_WIDE_REGS (compress-utils'
+ * WASM build only); ZSTD_FORCE_WIDE_REGS enables it on any target and exists
+ * only so the tests can exercise these paths on an ILP32 host.
+ * When disabled every name below is a plain alias of the size_t-keyed one, so
+ * the preprocessed output of every unit is unchanged. */
+#if (defined(__wasm32__) && defined(ZSTD_WASM_WIDE_REGS)) || defined(ZSTD_FORCE_WIDE_REGS)
+#  define MEM_regT U64
+#  define MEM_32bitRegs() 0
+#  define MEM_64bitRegs() 1
+#  define MEM_readRegT MEM_read64
+#  define MEM_readLERegT MEM_readLE64
+#  define MEM_writeLERegT MEM_writeLE64
+#else
+#  define MEM_regT size_t
+#  define MEM_32bitRegs() MEM_32bits()
+#  define MEM_64bitRegs() MEM_64bits()
+#  define MEM_readRegT MEM_readST
+#  define MEM_readLERegT MEM_readLEST
+#  define MEM_writeLERegT MEM_writeLEST
+#endif
+
